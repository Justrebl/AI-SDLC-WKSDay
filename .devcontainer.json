{
  "name": "Agentic SDLC Workshop",
  "image": "ghcr.io/justrebl/ai-sdlc-workshop/devcontainer:latest",
  "customizations": {
    "vscode": {
      "mcp": {
        "servers": {
          "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/"
          }
        }
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "MusicCatalog.slnx"
      }
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "forwardPorts": [
    5080,
    5173
  ],
  "portsAttributes": {
    "5080": {
      "label": "Music Catalog API"
    },
    "5173": {
      "label": "Music Catalog front end",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": {
    "gh-aw": "gh extension install github/gh-aw --force",
    "dotnet-restore": "dotnet restore",
    "front-end-dependencies": "npm --prefix src/front ci"
  },
  "remoteUser": "vscode"
}
